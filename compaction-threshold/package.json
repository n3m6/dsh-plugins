{
  "name": "@local/dsh-compaction-threshold",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "User-selectable context compaction threshold for the DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./backend": "./backend.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "backend.js",
    "client.js",
    "cordis.patch.yml",
    "regenerate-patch.mjs",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
